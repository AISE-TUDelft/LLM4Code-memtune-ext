    "    }\n",
    "   },\n",
    "   \"source\": [\n",
    "    \"import os\\n\",\n",
    "    \"import numpy as np\\n\",\n",
    "    \"import pandas as pd\\n\",\n",
    "    \"import matplotlib.pyplot as plt\\n\",\n",
    "    \"from cycler import cycler\\n\",\n",
    "    \"from matplotlib.patches import Patch\\n\",\n",
    "    \"\\n\",\n",
    "    \"line_cycler = (\\n\",\n",
    "    \"    cycler(color=[\\\"#E69F00\\\", \\\"#56B4E9\\\", \\\"#009E73\\\", \\\"#0072B2\\\", \\\"#D55E00\\\", \\\"#CC79A7\\\", \\\"#F0E442\\\"])\\n\",\n",
    "    \"    + cycler(linestyle=[\\\"-\\\", \\\"--\\\", \\\"-.\\\", \\\":\\\", \\\"-\\\", \\\"--\\\", \\\"-.\\\"])\\n\",\n",
    "    \")\\n\",\n",
    "    \"plt.rc(\\\"axes\\\", prop_cycle=line_cycler)\\n\",\n",
    "    \"\\n\",\n",
    "    \"METRICS = [\\\"em\\\", \\\"bleu\\\", \\\"meteor\\\", \\\"rougeL\\\"]\\n\",\n",
    "    \"\\n\",\n",
    "    \"def add_bar_labels(ax, bars, pad_frac=0.03, min_pad=0.001):\\n\",\n",
    "    \"    heights = np.array([bar.get_height() for bar in bars], dtype=float)\\n\",\n",
    "    \"    if heights.size == 0:\\n\",\n",
    "    \"        return 0.0, 0.0\\n\",\n",
    "    \"    max_abs = max(np.max(np.abs(heights)), 1e-6)\\n\",\n",
    "    \"    pad = max(min_pad, max_abs * pad_frac)\\n\",\n",
    "    \"    for bar, h in zip(bars, heights):\\n\",\n",
    "    \"        y = h + pad if h >= 0 else h - pad\\n\",\n",
    "    \"        va = \\\"bottom\\\" if h >= 0 else \\\"top\\\"\\n\",\n",
    "    \"        ax.text(\\n\",\n",
    "    \"            bar.get_x() + bar.get_width() / 2.0,\\n\",\n",
    "    \"            y,\\n\",\n",
    "    \"            f\\\"{h:.3f}\\\",\\n\",\n",
    "    \"            ha=\\\"center\\\",\\n\",\n",
    "    \"            va=va,\\n\",\n",
    "    \"            fontsize=8,\\n\",\n",
    "    \"            clip_on=False,\\n\",\n",
    "    \"        )\\n\",\n",
    "    \"    return float(np.min(heights) - pad), float(np.max(heights) + pad)\\n\",\n",
    "    \"\\n\",\n",
    "    \"def set_smart_ylim(ax, values, label_bounds=None, include_zero=True, margin_frac=0.08):\\n\",\n",
    "    \"    vals = np.array(values, dtype=float).reshape(-1)\\n\",\n",
    "    \"    if label_bounds is not None:\\n\",\n",
    "    \"        vals = np.concatenate([vals, np.array(label_bounds, dtype=float).reshape(-1)])\\n\",\n",
    "    \"    if vals.size == 0:\\n\",\n",
    "    \"        return\\n\",\n",
    "    \"    vmin, vmax = float(np.min(vals)), float(np.max(vals))\\n\",\n",
    "    \"    if include_zero:\\n\",\n",
    "    \"        vmin = min(vmin, 0.0)\\n\",\n",
    "    \"        vmax = max(vmax, 0.0)\\n\",\n",
    "    \"    span = max(vmax - vmin, 1e-6)\\n\",\n",
    "    \"    ax.set_ylim(vmin - span * margin_frac, vmax + span * margin_frac)\\n\"\n",
    "   ],\n",
    "   \"outputs\": [],\n",
    "   \"execution_count\": 23\n",
    "  },\n",
